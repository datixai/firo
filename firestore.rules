rules_version = '2';

// ─────────────────────────────────────────────────────────────
// FIRO — Firestore security rules
//
// Publish: Firebase Console → Firestore Database → Rules →
//          paste this file → Publish.
// (Copy your current rules somewhere first as a backup.)
//
// Collections
//   artifacts/{projectId}/public/data/fire_logs  Raspberry Pi detections
//   reports           public fire reports      (anyone creates, admins manage)
//   contact_messages  contact form messages    (anyone creates, admins manage)
//   blog_posts        blog articles, id = slug (public reads published, admins write)
//   admins            one doc per admin, id = user UID (created by hand in the console)
//   staff             control-room operators, id = user UID (managed by admins in /admin → Team)
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Signed in with email/password (not the anonymous visitor login)
    function isOfficer() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Control-room staff (or admins): can see and handle citizen reports
    function isStaff() {
      return isAdmin() || (signedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid)));
    }

    function isText(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    function isOptionalNumber(v) {
      return v == null || v is number;
    }

    // ── Raspberry Pi detection logs ──────────────────────────
    match /artifacts/{projectId}/public/data/fire_logs/{logId} {
      // Dashboard, analytics and the public logs page (anonymous sign-in)
      allow read: if signedIn();
      // The Pi normally writes with the Admin SDK (service account key),
      // which bypasses these rules. This line covers a client-SDK Pi.
      allow create: if signedIn();
      // "Resolve" button in the control room (keeps the original reading, adds status + time)
      allow update: if isOfficer()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['detection_class', 'fire_probability', 'status', 'resolved_ms']);
      allow delete: if isAdmin();
    }

    // ── Admin list ───────────────────────────────────────────
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // ── Control-room staff list ──────────────────────────────
    match /staff/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['email', 'name', 'added_ms', 'added_by'])
        && isText(request.resource.data.get('email', ''), 200)
        && isText(request.resource.data.get('name', ''), 100);
      allow delete: if isAdmin();
    }

    // ── Public fire reports ──────────────────────────────────
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'type', 'place', 'description', 'lat', 'lon', 'accuracy_m',
             'photo', 'name', 'phone', 'status', 'created_at', 'created_ms'])
        && request.resource.data.keys().hasAll(['type', 'place', 'status', 'created_at', 'created_ms'])
        && request.resource.data.type in ['smoke', 'small_fire', 'large_fire', 'near_homes']
        && isText(request.resource.data.place, 200)
        && request.resource.data.place.size() > 0
        && isText(request.resource.data.get('description', ''), 2000)
        && isOptionalNumber(request.resource.data.get('lat', null))
        && isOptionalNumber(request.resource.data.get('lon', null))
        && isOptionalNumber(request.resource.data.get('accuracy_m', null))
        && isText(request.resource.data.get('photo', ''), 900000)
        && isText(request.resource.data.get('name', ''), 100)
        && isText(request.resource.data.get('phone', ''), 30)
        && request.resource.data.status == 'new'
        && request.resource.data.created_at == request.time
        && request.resource.data.created_ms is int;
      allow read: if isStaff();
      // Staff move reports through the workflow; admins can edit anything
      allow update: if isAdmin() || (isStaff()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updated_ms', 'acknowledged_ms', 'resolved_ms', 'handled_by'])
        && request.resource.data.status in ['new', 'reviewing', 'verified', 'resolved', 'dismissed']);
      allow delete: if isAdmin();
    }

    // ── Contact form messages ────────────────────────────────
    match /contact_messages/{messageId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'name', 'email', 'subject', 'message', 'status', 'created_at', 'created_ms'])
        && request.resource.data.keys().hasAll([
             'name', 'email', 'subject', 'message', 'status', 'created_at', 'created_ms'])
        && isText(request.resource.data.name, 100)
        && request.resource.data.name.size() > 0
        && isText(request.resource.data.email, 200)
        && isText(request.resource.data.subject, 100)
        && isText(request.resource.data.message, 3000)
        && request.resource.data.message.size() > 0
        && request.resource.data.status == 'unread'
        && request.resource.data.created_at == request.time
        && request.resource.data.created_ms is int;
      allow read, update, delete: if isAdmin();
    }

    // ── Blog ─────────────────────────────────────────────────
    match /blog_posts/{slug} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }
  }
}
