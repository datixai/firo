rules_version = '2';

// ─────────────────────────────────────────────────────────────
// FIRO — Firestore security rules
//
// Publish: Firebase Console → Firestore Database → Rules →
//          paste this file → Publish.
// (Copy your current rules somewhere first as a backup.)
//
// Collections
//   artifacts/{projectId}/public/data/fire_logs  Raspberry Pi detections
//   reports           public fire reports      (anyone creates, admins manage)
//   contact_messages  contact form messages    (anyone creates, admins manage)
//   blog_posts        blog articles, id = slug (public reads published, admins write)
//   admins            one doc per admin, id = user UID (created by hand in the console)
//   staff             control-room operators, id = user UID (managed by admins in /admin → Team)
//   access_requests   "Request access" from the control room, id = user UID (admins approve in Team)
//   site_content      website text edited in /admin → Website content, id = page
//   volunteers        featured volunteer profiles on /volunteers (admins manage)
//   volunteer_applications  "Become a volunteer" form (anyone creates, admins manage)
//   volunteer_settings      doc "group": volunteers' WhatsApp group link (admins manage)
//   team_members      "The people behind FIRO" on /about (admins manage)
//   donation_pledges  Donate form (anyone creates, admins manage; private)
//   donation_records  donations received: amount, cause, date (public, admins write)
//   donation_uses     how donations were spent (public, admins write)
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Signed in with email/password (not the anonymous visitor login)
    function isOfficer() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Control-room staff (or admins): can see and handle citizen reports
    function isStaff() {
      return isAdmin() || (signedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid)));
    }

    function isText(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    function isOptionalNumber(v) {
      return v == null || v is number;
    }

    // ── Raspberry Pi detection logs ──────────────────────────
    match /artifacts/{projectId}/public/data/fire_logs/{logId} {
      // Dashboard, analytics and the public logs page (anonymous sign-in)
      allow read: if signedIn();
      // The Pi writes with the Admin SDK (service account key), which bypasses these
      // rules. A Pi using the client SDK must sign in with an account added as staff.
      // (Anyone can be signed in anonymously, so this must never be just signedIn().)
      allow create: if isStaff()
        && isText(request.resource.data.get('camera_location', ''), 200)
        && isText(request.resource.data.get('detection_class', ''), 100);
      // "Resolve" button in the control room (keeps the original reading, adds status + time)
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['detection_class', 'fire_probability', 'status', 'resolved_ms']);
      allow delete: if isAdmin();
    }

    // ── Admin list ───────────────────────────────────────────
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // ── Control-room staff list ──────────────────────────────
    match /staff/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['email', 'name', 'added_ms', 'added_by'])
        && isText(request.resource.data.get('email', ''), 200)
        && isText(request.resource.data.get('name', ''), 100);
      allow delete: if isAdmin();
    }

    // ── Control-room access requests ─────────────────────────
    match /access_requests/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list, delete: if isAdmin();
      allow create, update: if isOfficer() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'requested_ms'])
        && isText(request.resource.data.email, 200)
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.requested_ms is int;
    }

    // ── Website text (admin → Website content) ───────────────
    match /site_content/{page} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['fields', 'updated_ms', 'updated_by', 'posts_managed', 'profiles_managed', 'team_managed', 'starters_seen', 'products_managed'])
        && request.resource.data.get('fields', {}) is map
        && request.resource.data.get('starters_seen', []) is list
        && request.resource.data.get('posts_managed', false) is bool
        && request.resource.data.get('profiles_managed', false) is bool
        && request.resource.data.get('team_managed', false) is bool
        && request.resource.data.get('products_managed', false) is bool;
    }

    // ── Products (admin managed, doc id = slug) ──────────────
    match /products/{slug} {
      allow read: if isAdmin() || resource.data.published == true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && slug.matches('[a-z0-9-]{1,80}')
        && request.resource.data.keys().hasOnly([
             'slug', 'name', 'category', 'price', 'summary', 'description', 'specs',
             'photo', 'gallery', 'order', 'published', 'created_ms', 'updated_ms'])
        && request.resource.data.get('slug', slug) == slug
        && isText(request.resource.data.name, 120) && request.resource.data.name.size() > 0
        && request.resource.data.category in ['model', 'software', 'dashboard', 'hardware', 'config']
        && isText(request.resource.data.get('price', ''), 80)
        && isText(request.resource.data.get('summary', ''), 400)
        && isText(request.resource.data.get('description', ''), 20000)
        && request.resource.data.get('specs', []) is list && request.resource.data.get('specs', []).size() <= 20
        && request.resource.data.get('gallery', []) is list && request.resource.data.get('gallery', []).size() <= 4
        && request.resource.data.get('photo', '') is string
        && request.resource.data.published is bool;
    }

    // ── Team (About page) ────────────────────────────────────
    match /team_members/{id} {
      allow read: if isAdmin() || resource.data.published == true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && isText(request.resource.data.get('photo', ''), 500)
        && (request.resource.data.get('photo', '') == '' || request.resource.data.photo.matches('https://.+'));
    }

    // ── Donations ────────────────────────────────────────────
    function isCause(v) {
      return v in ['plantation', 'equipment', 'cameras', 'awareness', 'wildlife', 'general'];
    }
    function isAmount(v) {
      return v is number && v > 0 && v <= 1000000000;
    }

    match /donation_pledges/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'category', 'amount', 'currency', 'name', 'email', 'phone', 'location', 'message',
             'status', 'created_at', 'created_ms'])
        && request.resource.data.keys().hasAll([
             'category', 'amount', 'currency', 'name', 'email', 'phone', 'status', 'created_at', 'created_ms'])
        && isCause(request.resource.data.category)
        && isAmount(request.resource.data.amount)
        && request.resource.data.currency in ['PKR', 'USD', 'GBP', 'EUR', 'SAR', 'AED']
        && isText(request.resource.data.name, 100) && request.resource.data.name.size() > 0
        && isText(request.resource.data.email, 200) && request.resource.data.email.size() > 0
        && isText(request.resource.data.phone, 30) && request.resource.data.phone.size() > 0
        && isText(request.resource.data.get('location', ''), 150)
        && isText(request.resource.data.get('message', ''), 2000)
        && request.resource.data.status == 'new'
        && request.resource.data.created_at == request.time
        && request.resource.data.created_ms is int;
      allow read, update, delete: if isAdmin();
    }

    // Public totals: only amount, cause and date, never who gave
    match /donation_records/{id} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['amount', 'category', 'year', 'received_ms', 'pledge_id', 'created_ms', 'updated_ms'])
        && isAmount(request.resource.data.amount)
        && isCause(request.resource.data.category)
        && request.resource.data.year is int
        && request.resource.data.received_ms is int;
    }

    match /donation_uses/{id} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'description', 'amount', 'category', 'year', 'date_ms', 'created_ms', 'updated_ms'])
        && isText(request.resource.data.title, 150) && request.resource.data.title.size() > 0
        && isText(request.resource.data.get('description', ''), 1500)
        && isAmount(request.resource.data.amount)
        && isCause(request.resource.data.category)
        && request.resource.data.year is int
        && request.resource.data.date_ms is int;
    }

    // ── Volunteers ───────────────────────────────────────────
    match /volunteers/{id} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }

    match /volunteer_applications/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'name', 'location', 'motivation', 'email', 'phone', 'status', 'created_at', 'created_ms'])
        && request.resource.data.keys().hasAll([
             'name', 'location', 'motivation', 'email', 'phone', 'status', 'created_at', 'created_ms'])
        && isText(request.resource.data.name, 100) && request.resource.data.name.size() > 0
        && isText(request.resource.data.location, 150) && request.resource.data.location.size() > 0
        && isText(request.resource.data.motivation, 2000) && request.resource.data.motivation.size() > 0
        && isText(request.resource.data.email, 200) && request.resource.data.email.size() > 0
        && isText(request.resource.data.phone, 30) && request.resource.data.phone.size() > 0
        && request.resource.data.status == 'pending'
        && request.resource.data.created_at == request.time
        && request.resource.data.created_ms is int;
      allow read, update, delete: if isAdmin();
    }

    // Anyone may read the group link only when the admin has made it public
    match /volunteer_settings/{id} {
      allow read: if isAdmin() || resource.data.public == true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['link', 'public', 'updated_ms', 'updated_by'])
        && isText(request.resource.data.link, 300)
        && (request.resource.data.link == '' || request.resource.data.link.matches('https://chat[.]whatsapp[.]com/.+'))
        && request.resource.data.public is bool;
    }

    // ── Public fire reports ──────────────────────────────────
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'type', 'place', 'description', 'lat', 'lon', 'accuracy_m',
             'photo', 'name', 'phone', 'status', 'created_at', 'created_ms'])
        && request.resource.data.keys().hasAll(['type', 'place', 'status', 'created_at', 'created_ms'])
        && request.resource.data.type in ['smoke', 'small_fire', 'large_fire', 'near_homes']
        && isText(request.resource.data.place, 200)
        && request.resource.data.place.size() > 0
        && isText(request.resource.data.get('description', ''), 2000)
        && isOptionalNumber(request.resource.data.get('lat', null))
        && isOptionalNumber(request.resource.data.get('lon', null))
        && isOptionalNumber(request.resource.data.get('accuracy_m', null))
        && isText(request.resource.data.get('photo', ''), 900000)
        && isText(request.resource.data.get('name', ''), 100)
        && isText(request.resource.data.get('phone', ''), 30)
        && request.resource.data.status == 'new'
        && request.resource.data.created_at == request.time
        && request.resource.data.created_ms is int;
      allow read: if isStaff();
      // Staff move reports through the workflow; admins can edit anything
      allow update: if isAdmin() || (isStaff()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updated_ms', 'acknowledged_ms', 'resolved_ms', 'handled_by'])
        && request.resource.data.status in ['new', 'reviewing', 'verified', 'resolved', 'dismissed']);
      allow delete: if isAdmin();
    }

    // ── Contact form messages ────────────────────────────────
    match /contact_messages/{messageId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'name', 'email', 'subject', 'message', 'status', 'created_at', 'created_ms'])
        && request.resource.data.keys().hasAll([
             'name', 'email', 'subject', 'message', 'status', 'created_at', 'created_ms'])
        && isText(request.resource.data.name, 100)
        && request.resource.data.name.size() > 0
        && isText(request.resource.data.email, 200)
        && isText(request.resource.data.subject, 100)
        && isText(request.resource.data.message, 3000)
        && request.resource.data.message.size() > 0
        && request.resource.data.status == 'unread'
        && request.resource.data.created_at == request.time
        && request.resource.data.created_ms is int;
      allow read, update, delete: if isAdmin();
    }

    // ── Blog ─────────────────────────────────────────────────
    match /blog_posts/{slug} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }
  }
}
