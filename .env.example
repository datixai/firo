# ─────────────────────────────────────────────────────────────
# FIRO dashboard — runtime config
#
# Local:   copy this file to .env.local and fill in the values
#          (or put service_account_key.json in secrets/ instead)
# Vercel:  add the same names under Project → Settings →
#          Environment Variables
#
# Values come from Firebase Console → Project settings →
# General → Your apps → Web app → SDK setup and configuration.
# These are the PUBLIC web-app settings, NOT the private key.
# ─────────────────────────────────────────────────────────────

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=wildfire-monitoring-1ccca.firebaseapp.com
FIREBASE_PROJECT_ID=wildfire-monitoring-1ccca
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# WhatsApp number for the "Send" button (international format, no "+")
FIRO_WHATSAPP_NUMBER=923408226347

# Optional email address shown on the Contact page
FIRO_CONTACT_EMAIL=
